-- 6. 🎃 FORCE DROP (TRIGGER SpawnItem REMOTE)
--------------------------------------------------------------------------------
local ForceDropBtn = createButton("💥 FORCE DROP (TRIGGER SpawnItem)", 6)

ForceDropBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local pos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame or CFrame.new()

    local remote = ReplicatedStorage:FindFirstChild("SpawnItem", true) or Workspace:FindFirstChild("SpawnItem", true)
    if remote then
        if remote:IsA("RemoteEvent") then
            local tool = char and char:FindFirstChildOfClass("Tool")
            remote:FireServer(tool and tool.Name or "Drop", pos)
            ForceDropBtn.Text = "💥 FIRED SpawnItem REMOTE!"
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer("Drop", pos)
            ForceDropBtn.Text = "💥 INVOKED SpawnItem REMOTE!"
        end
    else
        local found = false
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name:lower():find("spawnitem") then
                v:FireServer()
                found = true
            end
        end
        ForceDropBtn.Text = found and "💥 TRIGGERED SpawnItem EVENT!" or "⚠️ SpawnItem REMOTE NOT FOUND!"
    end

    task.delay(1.5, function()
        ForceDropBtn.Text = "💥 FORCE DROP (TRIGGER SpawnItem)"
    end)
end)

