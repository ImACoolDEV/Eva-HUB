-- Shared In-Server Global Event Sync
local globalRemote = ReplicatedStorage:FindFirstChild("EvaHubGlobalChat")
if not globalRemote then
    globalRemote = Instance.new("BindableEvent")
    globalRemote.Name = "EvaHubGlobalChat"
    globalRemote.Parent = ReplicatedStorage
end

Connections.ChatReceiver = globalRemote.Event:Connect(function(sender, message)
    appendChatMessage(sender, message)
end)

local function sendMessage()
    local txt = ChatInputBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if txt ~= "" then
        globalRemote:Fire(LocalPlayer.Name, txt)
        ChatInputBox.Text = ""
    end
end

SendBtn.Activated:Connect(sendMessage)
ChatInputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessage() end
end)

