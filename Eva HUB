local HellsBtn, HellsStroke = createButton("🔥 START HELLSAWAKENING MODE", 3)

HellsBtn.Activated:Connect(function()
    local triggered = false
    local rakeModel = Workspace:FindFirstChild("the_rake", true) or Workspace:FindFirstChild("The_Rake", true) or Workspace:FindFirstChild("Rake", true)
    
    local startModeRemote = (rakeModel and rakeModel:FindFirstChild("StartMode", true))
