local TabFrames = {}
local TabButtons = {}

local function createTab(name, icon, order)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(42, 24, 60)
    btn.Text = "   " .. icon .. "  " .. name
    btn.TextColor3 = Color3.fromRGB(255, 180, 230)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.ZIndex = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", btn).Color = Color3.fromRGB(255, 120, 190)

    local page = Instance.new("Frame", ContentArea)
    page.Size = UDim2.new(1, -16, 1, -16)
    page.Position = UDim2.new(0, 8, 0, 8)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ZIndex = 13

    TabFrames[name] = page
    TabButtons[name] = btn

    btn.Activated:Connect(function()
        for tName, tPage in pairs(TabFrames) do
            tPage.Visible = (tName == name)
            local tBtn = TabButtons[tName]
            if tName == name then
                tBtn.BackgroundColor3 = Color3.fromRGB(255, 110, 180)
                tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                tBtn.BackgroundColor3 = Color3.fromRGB(42, 24, 60)
                tBtn.TextColor3 = Color3.fromRGB(255, 180, 230)
            end
        end
    end)

    return page
end

