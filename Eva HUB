local FlyBtn, FlyStroke = createButton("🦅 FLY HACK: OFF", 2)
local flyActive = false
local flyBodyVel, flyBodyGyro

FlyBtn.Activated:Connect(function()
    flyActive = not flyActive
    
    if Connections.Fly then Connections.Fly:Disconnect() Connections.Fly = nil end
    if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end

    if flyActive then
        FlyBtn.Text = "🦅 FLY HACK: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(180, 70, 140)
        FlyStroke.Color = Color3.fromRGB(255, 160, 220)

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            flyBodyVel = Instance.new("BodyVelocity")
            flyBodyVel.MaxForce = Vector3.new(1, 1, 1) * 1e6
            flyBodyVel.Velocity = Vector3.zero
            flyBodyVel.Parent = hrp

            flyBodyGyro = Instance.new("BodyGyro")
            flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 1e6
            flyBodyGyro.CFrame = hrp.CFrame
            flyBodyGyro.Parent = hrp

            Connections.Fly = RunService.RenderStepped:Connect(function()
                if not flyActive or not hrp or not flyBodyVel or not flyBodyGyro then return end
                local camCF = Workspace.CurrentCamera.CFrame
                flyBodyGyro.CFrame = camCF
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
                flyBodyVel.Velocity = (dir.Magnitude > 0) and (dir.Unit * 60) or Vector3.zero
            end)
        end
    else
        FlyBtn.Text = "🦅 FLY HACK: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(42, 24, 60)
        FlyStroke.Color = Color3.fromRGB(255, 120, 190)
    end
end)

