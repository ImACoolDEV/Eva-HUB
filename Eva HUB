RunService.RenderStepped:Connect(function()
    if aiBattleActive then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local closestNpc = nil
            local closestDist = math.huge
            for _, model in pairs(Workspace:GetChildren()) do
                if model:IsA("Model") and model ~= char and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
                    if not Players:GetPlayerFromCharacter(model) then
                        local dist = (model.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestNpc = model
                        end
                    end
                end
            end
            if closestNpc and closestNpc:FindFirstChild("HumanoidRootPart") then
                local angle = tick() * 10
                hrp.CFrame = CFrame.new(closestNpc.HumanoidRootPart.Position + Vector3.new(math.cos(angle) * 7, 2, math.sin(angle) * 7), closestNpc.HumanoidRootPart.Position)
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end
        end
    end
end)

