local function isNokia(item)
    return item.Name:lower():find("nokia") ~= nil
end

local function isFoodOrFish(item)
    local n = item.Name:lower()
    return not isNokia(item) and (n:find("fish") or n:find("megafish") or n:find("food") or n:find("burger") or n:find("apple") or n:find("pizza") or n:find("meat"))
end

