    local catIcons = {"🐾", "🐱", "🎃", "👻", "🦇", "🍬"}
    while true do
        task.wait(2)
        local icon = catIcons[math.random(1, #catIcons)]
        TitleText.Text = icon .. " EVA HUB — SPOOKY CAT " .. icon
    end
end)
