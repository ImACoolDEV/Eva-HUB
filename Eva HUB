        if startModeRemote:IsA("RemoteEvent") then
            startModeRemote:FireServer("HellsAwakening")
            startModeRemote:FireServer("HellsAwakeningMain")
            triggered = true
        elseif startModeRemote:IsA("BindableEvent") then
            startModeRemote:Fire("HellsAwakening")
            startModeRemote:Fire("HellsAwakeningMain")
            triggered = true
        elseif startModeRemote:IsA("RemoteFunction") then
            pcall(function() startModeRemote:InvokeServer("HellsAwakening") end)
            triggered = true
        end
    end

    if not triggered then
        for _, obj in pairs(game:GetDescendants()) do
            if (obj:IsA("RemoteEvent") or obj:IsA("BindableEvent")) and obj.Name:lower():find("startmode") then
                if obj:IsA("RemoteEvent") then
                    obj:FireServer("HellsAwakening")
                    obj:FireServer("HellsAwakeningMain")
