local AiHpBtn = createButton("AiHpBtn", "💀 Set Nearest AI/NPC HP to 1000%")

AiHpBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local pPos = char.HumanoidRootPart.Position
        local closestNpc = nil
        local closestDist = math.huge

        for _, model in pairs(workspace:GetChildren()) do
            if model:IsA("Model") and model ~= char and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
                if not Players:GetPlayerFromCharacter(model) then
                    local dist = (model.HumanoidRootPart.Position - pPos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestNpc = model
                    end
                end
            end
        end

        if closestNpc then
            local hum = closestNpc:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.MaxHealth = hum.MaxHealth * 10
                hum.Health = hum.MaxHealth
                AiHpBtn.Text = "💀 Boosted " .. closestNpc.Name .. " to 1000% HP!"
                task.wait(1.5)
                AiHpBtn.Text = "💀 Set Nearest AI/NPC HP to 1000%"
            end
        end
    end
end)

-- ========================================================
-- FEATURE 3: FORCE DROP VIA SpawnItem REMOTE EVENT
-- ========================================================

local ForceDropBtn = createButton("ForceDropBtn", "🎃 Force Drop (Trigger SpawnItem Remote)")

ForceDropBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local pos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame or CFrame.new()

    -- Search game for SpawnItem RemoteEvent or RemoteFunction
    local remote = ReplicatedStorage:FindFirstChild("SpawnItem", true) 
        or workspace:FindFirstChild("SpawnItem", true)

    if remote then
        if remote:IsA("RemoteEvent") then
            -- Fires equipped tool or default drop parameter
            local equippedTool = char and char:FindFirstChildOfClass("Tool")
            if equippedTool then
                remote:FireServer(equippedTool.Name, pos)
            else
                remote:FireServer("Drop", pos)
            end
            ForceDropBtn.Text = "🎃 Fired SpawnItem Remote!"
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer("Drop", pos)
            ForceDropBtn.Text = "🎃 Invoked SpawnItem Remote!"
        end
    else
        -- Fallback: Loop through game to trigger any remote containing "SpawnItem"
        local found = false
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name:lower():find("spawnitem") then
                v:FireServer()
                found = true
            end
        end
        if found then
            ForceDropBtn.Text = "🎃 Triggered SpawnItem Event!"
        else
            ForceDropBtn.Text = "⚠️ 'SpawnItem' Remote Not Found!"
        end
    end

    task.wait(1.5)
    ForceDropBtn.Text = "🎃 Force Drop (Trigger SpawnItem Remote)"
end)

